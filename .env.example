# LLM Provider: demo | ollama | gemini | openai
LLM_PROVIDER=demo

# Ollama Local LLM Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=mistral

# Cloud LLM API Keys (Optional)
GEMINI_API_KEY=
OPENAI_API_KEY=

# Threat Intelligence APIs (Optional - free keys from virustotal.com & abuseipdb.com)
VIRUSTOTAL_API_KEY=
ABUSEIPDB_API_KEY=

# Automated Containment (True = automatically block IPs with Level >= 12)
AUTO_CONTAINMENT_ENABLED=false
